# Folder watcher ingress (monitors a local directory for incoming PDFs)
FOLDER_ENABLED=false
FOLDER_INPUT_DIR=./input
# FOLDER_OUTPUT_DIR=./output  # omit to rename in place
FOLDER_POLL_INTERVAL_SEC=5

# FTP ingress configuration
FTP_ENABLED=true
FTP_HOST=0.0.0.0
FTP_PORT=21
FTP_USERNAME=REPLACE_ME
FTP_PASSWORD=REPLACE_ME
FTP_UPLOAD_DIR=/app/storage/inbox
# Passive data ports and the address advertised to clients (set to the host LAN IP behind Docker/NAT)
FTP_PASSIVE_PORTS=21000-21010
# FTP_PASSIVE_HOST=192.168.1.10

# SFTP ingress (SSH file transfer; most network scanners call this "SFTP")
SFTP_ENABLED=false
SFTP_HOST=0.0.0.0
SFTP_PORT=2222
SFTP_USERNAME=REPLACE_ME
SFTP_PASSWORD=REPLACE_ME
SFTP_UPLOAD_DIR=/app/storage/inbox
# Generated on first start if missing
SFTP_HOST_KEY=/app/storage/ssh/ssh_host_ed25519_key

# SCP ingress (legacy SCP protocol; OpenSSH 9+ clients need `scp -O`)
SCP_ENABLED=false
SCP_HOST=0.0.0.0
SCP_PORT=2223
SCP_USERNAME=REPLACE_ME
SCP_PASSWORD=REPLACE_ME
SCP_UPLOAD_DIR=/app/storage/inbox
SCP_HOST_KEY=/app/storage/ssh/ssh_host_ed25519_key

# Samba server configuration (polls remote SMB share for incoming PDFs)
SAMBA_SERVER_ENABLED=false
SAMBA_SERVER_HOST=127.0.0.1
SAMBA_SERVER_PORT=445
SAMBA_SERVER_USERNAME=REPLACE_ME
SAMBA_SERVER_PASSWORD=REPLACE_ME
SAMBA_SERVER_SHARE=REPLACE_ME
SAMBA_SERVER_PATH=/scans
SAMBA_SERVER_POLL_INTERVAL_SEC=10
SAMBA_SERVER_DELETE_AFTER_READ=true
SAMBA_SERVER_WORK_DIR=/app/storage/inbox

# Optional backward-compatible aliases (deprecated)
# SAMBA_INGRESS_ENABLED=
# SAMBA_INGRESS_HOST=
# SAMBA_INGRESS_PORT=
# SAMBA_INGRESS_USERNAME=
# SAMBA_INGRESS_PASSWORD=
# SAMBA_INGRESS_SHARE=
# SAMBA_INGRESS_PATH=
# SAMBA_INGRESS_POLL_INTERVAL_SEC=
# SAMBA_INGRESS_DELETE_AFTER_READ=
# SAMBA_INGRESS_WORK_DIR=

# WebDAV provider configuration
WEBDAV_ENABLED=true
WEBDAV_URL=https://cloud.example.com/webdav
WEBDAV_USERNAME=REPLACE_ME
WEBDAV_PASSWORD=REPLACE_ME
WEBDAV_INSECURE=false
LANGUAGE=English

# Samba provider configuration (processed file destination)
SAMBA_ENABLED=true
SAMBA_HOST=127.0.0.1
SAMBA_PORT=445
SAMBA_USERNAME=REPLACE_ME
SAMBA_PASSWORD=REPLACE_ME
SAMBA_SHARE=REPLACE_ME
SAMBA_PATH=/scans


OLLAMA_MODEL=qwen3-vl:8b
# Context window (in tokens) requested from Ollama per call. Raise this if you see
# "exceeds the available context size" errors in the Ollama logs.
OLLAMA_NUM_CTX=8192
# Seconds to wait for a filename before falling back to scan_<timestamp>.pdf.
# Thinking models (e.g. qwen3-vl:8b) can need several minutes per page.
OLLAMA_TIMEOUT=120

# Ollama GPU acceleration (docker-compose)
# Set to "gpu" to run Ollama with NVIDIA GPU support, or "cpu" for CPU-only
COMPOSE_PROFILES=cpu
# Number of GPUs to reserve when COMPOSE_PROFILES=gpu
OLLAMA_GPU_COUNT=1
